# Copy to .env.local for local development. Never commit secrets.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DB?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_ENDPOINT=https://private-object-storage.example
S3_REGION=us-east-1
S3_BUCKET=memyra-private-photos
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Flags default off; enable explicitly per environment.
FEATURE_AI_COMPARISON=false
FEATURE_ADVANCED_IMAGE_ANALYSIS=false
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_EXPERIMENTAL_PROTOCOLS=false
